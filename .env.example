# Server-only URL for the deployed, sanitized Google Apps Script bridge.
# Do not prefix this variable with NEXT_PUBLIC_.
HILLSIDE_DATA_FEED_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Private alternative-meal order workflow. Keep every value server-only.
# Leave HILLSIDE_MEAL_ORDER_ENABLED=false until the private Apps Script
# destination, shared secret, and end-to-end tests are complete.
HILLSIDE_MEAL_ORDER_ENABLED=false
HILLSIDE_MEAL_ORDER_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_ME/exec
HILLSIDE_MEAL_ORDER_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional and development-only. This permits a local synthetic-data test to
# reach the real private sheet. Never configure it on the public website host.
HILLSIDE_MEAL_ORDER_LOCAL_LIVE_TEST=false

# Private grievance, package-request, and visitor-request workflow. One
# server-only destination routes validated requests into three separately
# restricted management workbooks.
HILLSIDE_PATIENT_REQUESTS_ENABLED=false
HILLSIDE_PATIENT_REQUESTS_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_ME/exec
HILLSIDE_PATIENT_REQUESTS_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional and development-only. This permits a local synthetic-data test to
# reach the real private sheets. Never configure it on the public website host.
HILLSIDE_PATIENT_REQUESTS_LOCAL_LIVE_TEST=false
